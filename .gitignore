# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...mais .env.example DOIT être versionné : c'est la documentation des
# variables disponibles. Sans cette exception, `.env*` l'exclurait aussi.
!.env.example

# Données persistantes : base SQLite et fichiers uploadés.
# ⚠️ Ne jamais versionner — contient les contenus et les empreintes de mots
# de passe.
/.data/

# Sauvegardes produites par scripts/sauvegarde.sh
/sauvegardes/

# Réglages Claude Code propres à une machine (autorisations locales).
# .claude/launch.json, lui, est versionné : il décrit comment lancer le projet.
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
